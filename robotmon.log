[Result] {"result":"function () {\n  console.log(\"[doFriendLike] 開始\");\n\n  // 步驟1: 點擊 mainpage3 按鈕（社群頁）\n  this.clickIcon(\"mainpage3\");\n  sleep(3000);\n\n  // 步驟2: 等待朋友頁面載入完成\n  var loaded = false;\n  for (var w = 0; w \u003c 20 \u0026\u0026 this.isRunning(); w++) {\n    var ss = this.screen.getScreenshotResize();\n    loaded = this.screen.isFriendPageLoadedScreen(ss);\n    releaseImage(ss);\n    if (loaded) { break; }\n    sleep(1000);\n  }\n  if (!loaded) {\n    console.log(\"[doFriendLike] 朋友頁面未載入，結束\");\n    return;\n  }\n  console.log(\"[doFriendLike] 朋友頁面已載入\");\n\n  // 步驟3: 等待進入「他人的收藏」頁面；若仍停在朋友頁面則再點擊「他人的收藏」按鈕\n  var onOther = false;\n  for (var w2 = 0; w2 \u003c 20 \u0026\u0026 this.isRunning(); w2++) {\n    var ss2 = this.screen.getScreenshotResize();\n    onOther = this.screen.isFriendOtherTopScreen(ss2);\n    if (onOther) { releaseImage(ss2); break; }\n    if (this.screen.isFriendPageLoadedScreen(ss2)) {\n      this.tapAlign(540, 1120, Align.CENTER, Align.MAX);\n    }\n    releaseImage(ss2);\n    sleep(1000);\n  }\n  if (!onOther) {\n    console.log(\"[doFriendLike] 未進入他人的收藏頁面，結束\");\n    return;\n  }\n  console.log(\"[doFriendLike] 進入他人的收藏頁面\");\n\n  // 步驟4: 捲動至頁面底部\n  \n  this.drag(500,1400,500,600);\n  sleep(1000);\n  this.drag(500,1400,500,600);\n  sleep(1000);\n\n  // 步驟5: 點讚 loop\n  while (this.isRunning()) {\n    var ssScan = this.screen.getScreenshotResize();\n    var thumbs = this.screen.scanThumbsUp();\n    releaseImage(ssScan);\n\n    console.log(\"[doFriendLike] 偵測到 \" + thumbs.length + \" 個大拇指\");\n\n    // 5-1: 點擊未按過的大拇指\n    var clickedAny = false;\n    for (var ti = 0; ti \u003c thumbs.length; ti++) {\n      var t = thumbs[ti];\n      console.log(\"[doFriendLike] 大拇指 x=\" + t.x + \" clicked=\" + t.clicked);\n      if (!t.clicked) {\n        this.tapAlign(t.midX, THUMB_SCAN_Y, Align.CENTER, Align.MAX);\n        sleep(1000);\n        clickedAny = true;\n      }\n    }\n\n    if (clickedAny) { continue; }\n\n    // 5-2: 全部已按過，往右滑動\n    var ssBefore = this.screen.getScreenshotResize();\n    var _swipeY = this.screen.realScreenSize[1] - 920;\n    this.drag(800, _swipeY, 200, _swipeY);\n    sleep(500);\n    var ssAfter = this.screen.getScreenshotResize();\n    var cmp = findImage(ssBefore, ssAfter);\n    var unchanged = cmp \u0026\u0026 cmp.score \u003e= 0.99;\n    releaseImage(ssBefore);\n    releaseImage(ssAfter);\n\n    if (unchanged) {\n      // 5-3: 已滑到底，結束\n      console.log(\"[doFriendLike] 已滑到底，點讚完成\");\n      break;\n    }\n  }\n\n  // 返回主畫面\n  console.log(\"[doFriendLike] 返回主畫面\");\n  this.clickIcon(\"mainpage1\");\n  sleep(1000);\n  for (var wr = 0; wr \u003c 20 \u0026\u0026 this.isRunning(); wr++) {\n    var ssR = this.screen.getScreenshotResize();\n    var onMain = this.screen.isMainMenuScreen(ssR);\n    releaseImage(ssR);\n    if (onMain) { console.log(\"[doFriendLike] 已回到主畫面\"); break; }\n    sleep(1000);\n  }\n}","rid":400}
